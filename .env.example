# .env.example
# 复制这个文件为 .env（同一目录下），把下面的占位值换成你自己的真实密钥。
# .env 本身已经在 .gitignore 里，不会被提交到仓库——这个 .env.example 才是
# 应该提交到仓库的部分，让别人知道需要配置哪几个变量、去哪申请。

# 智谱AI（bigmodel.cn）的API Key。注册地址：https://open.bigmodel.cn/
# 免费额度和免费模型都够跑通这个项目，不需要充值。
LLM_API_KEY=your_zhipu_api_key_here

# 对话模型的模型ID。注意要带具体的日期后缀（比如 glm-4-flash-250414），
# 不要只写模型族名（比如 glm-4-flash）——另外要小心带"x"后缀的模型
# （比如 glm-4-flashx-250414）是付费档，跟不带x的免费模型容易搞混。
# 选模型时除了看是否免费、是否支持Function Calling，还要留意智谱账户后台
# 该模型的"并发数限制"（不是每分钟请求数配额）——本项目最初用的glm-4.7-flash
# 并发数只有1，开发时极易触发429，换成并发数20的glm-4-flash-250414解决。
LLM_MODEL_ID=glm-4-flash-250414

# 智谱OpenAI兼容接口的base_url，固定值，一般不用改
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 高德开放平台的Key，用于WeatherAgent通过MCP协议查询天气。
# 申请地址：https://lbs.amap.com/ （注册开发者账号后创建"Web服务"类型的Key）
AMAP_MAPS_API_KEY=your_amap_key_here
